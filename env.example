# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Database: Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible storage)
# Endpoint looks like https://<account-id>.r2.cloudflarestorage.com (no bucket name)
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="snapgram-images"
# Public URL of the bucket, without a trailing slash, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=""

# Email (optional). If RESEND_API_KEY is empty, emails are printed in the terminal.
RESEND_API_KEY=""
EMAIL_FROM="Snapgram <onboarding@resend.dev>"
